<?xml version="1.0" encoding="UTF-8"?>
<widget id="com.liferpg.lifelevelup" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Life Level Up</name>
  <description>Offline RPG productivity tracker for daily quests, XP, streaks and rewards.</description>
  <author email="support@example.invalid" href="https://example.invalid">Life Level Up</author>
  <content src="index.html" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="Orientation" value="portrait" />
  <preference name="AndroidXEnabled" value="true" />
  <preference name="BackupWebStorage" value="local" />
  <platform name="android">
    <icon src="icon.png" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="35" />
  </platform>
</widget>
