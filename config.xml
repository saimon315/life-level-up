<?xml version='1.0' encoding='utf-8'?>
<widget id="com.liferpg.lifelevelup" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Life Level Up</name>
    <description>Offline Life Level Up Android App</description>
    <content src="index.html" />
    <access origin="*" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="Orientation" value="portrait" />
    <preference name="DisallowOverscroll" value="true" />
    <icon src="icon.png" />
    <plugin name="cordova-plugin-local-notification-12" />
    <platform name="android">
        <icon density="xxxhdpi" background="icon-background.png" foreground="icon-foreground.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#ffffff" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="splash_icon.png" />
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.VIBRATE" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
        </config-file>
    </platform>
</widget>
